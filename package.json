{
  "name": "hexablock-suite-api",
  "version": "0.1.0",
  "description": "REST API for HexaBlock Suite: users, progress, leaderboards and level definitions",
  "author": "HexaBlock Suite team",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "lint:arch": "depcruise src --config .dependency-cruiser.js",
    "prepare": "husky",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "lint:tests": "node scripts/check-test-names.mjs test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/unit/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        },
        "testEnvironment": "node",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ]
      },
      {
        "displayName": "integration",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/integration/**/*.int-spec.ts"
        ],
        "transform": {
          "^.+\\.ts$": "ts-jest"
        },
        "testEnvironment": "node",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage"
  }
}
